      "prior_winback_count_12m": 0,
      "prior_winback_response_rate_lifetime": null,
      "expected_winback_propensity_signal": "elevated",
      "expected_churn_risk_class": "medium",
      "expected_winback_eligibility": "ineligible_consent"
    },
    {
      "customer_token": "tok-cust-E",
      "loyalty_tier": "silver",
      "lifetime_value_bucket": "low",
      "trailing_90d_visit_count": 1,
      "trailing_90d_visit_count_prior_period": 6,
      "visit_velocity_change_pct": -83.3,
      "service_interactions_negative_count": 4,
      "consent_marketing": true,
      "consent_personalization": true,
      "prior_winback_count_12m": 2,

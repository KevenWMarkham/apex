# Pack Personas — {{ pack_id }}@{{ pack_version }}
# Generated by RAPIDS apex-persona-mapper · {{ generated_ts }}

personas:
{% for persona in personas %}
  - id: {{ persona.id }}
    display_name: {{ persona.display_name }}
    identity_binding:
      apex-m: { source: entra,              group_oid: {{ persona.entra_group_oid }} }
      apex-g: { source: cloud_identity,     group_email: {{ persona.gcp_group_email }} }
      apex-a: { source: iam_identity_center,group_arn: {{ persona.aws_group_arn }} }
    entitlement_scope: {{ persona.entitlement_scope }}
    sla:
      warn: {{ persona.sla_warn }}
      critical: {{ persona.sla_critical }}
    escalation_chain: {{ persona.escalation_chain }}
    channel:
      apex-m: teams_channel: {{ persona.teams_channel }}
      apex-g: chat_space: {{ persona.chat_space }}
      apex-a: slack_channel: {{ persona.slack_channel }}
{% endfor %}

  "winback_basis": {
    "tok-cust-A": {
      "predicted_ltv_decline_24m_usd": 1820.00,
      "matched_offer_rules": [{"rule_natural": "WB-2026-PLAT-CAP", "max_offer_pct": 35.0, "margin_floor_pct": 18.0}],
      "expected_recommended_offer_depth_pct": 30,
      "expected_binding_constraint": "max_offer_pct_rule"
    },
    "tok-cust-C": {
      "predicted_ltv_decline_24m_usd": 1240.00,
      "matched_offer_rules": [{"rule_natural": "WB-2026-PLAT-CAP", "max_offer_pct": 35.0, "margin_floor_pct": 18.0}],
      "expected_recommended_offer_depth_pct": 20,
      "expected_binding_constraint": "none"
    }
  },

  "expected_chain_behavior": {
    "step_13_assess": {
      "should_emit_to": "g_loyalty_churn_cohort",
      "should_classify_signals": {"elevated": 4, "low": 1}
    },
    "step_14_classify": {
      "should_score_class": {"high": 2, "medium": 2, "low": 1},
      "should_eligibility_breakdown": {
        "eligible": 2,
        "ineligible_consent": 1,
        "ineligible_recent_winback": 1,
        "ineligible_low_ltv": 0
      }
    },
    "step_15_quantify": {
      "should_emit_to": "g_winback_offer_basis",
      "should_compute_per_member_economics_for_eligible_only": true,
      "expected_eligible_count": 2
    },
    "step_16_decide": {
      "decision_class": "hitl_required",
      "expected_hitl_persona": "maya-patel-loyalty-crm-director",
      "channel": "teams-adaptive-card",
      "reason": "tier_3_pii_unlock_required true AND offer_kind percent_off → must HITL"
    },
    "step_16_decide_post_approval": {
      "should_invoke": "tokenizer-mcp.bulk_detokenize",
      "ttl_seconds": 60,
      "purpose": "winback_offer_distribution",
      "expected_unlock_request_id_present": true
    },
    "step_17_act": {
      "should_call": "rc_e2e_04.commit_winback_offer",
      "should_write_to": ["CXML.Campaign", "CXML.Loyalty"],
      "should_push_to_engagement_system": true,
      "should_complete_within_ttl_seconds": 60
    },
    "step_18_learn": {
      "should_emit_ledger_rows_count": 2,
      "should_redis_similarity_keys_per_member": 2,
      "should_emit_campaign_digest_to_persona": "maya-patel-loyalty-crm-director"
    }
  },

  "expected_kpi_movement": {
    "loyalty-churn-rate-pct": {
      "target_direction": "decrease",
      "expected_drop": 22,
      "baseline_note": "per Services Guide §18.2 envelope: top tier churn rate -22%"
    },
    "winback-response-rate-pp-lift": {
      "target_direction": "increase",
      "expected_pp_lift": 17
    },
    "saved-customer-ltv-pct-lift": {
      "target_direction": "increase",
      "expected_pct_lift": 34
    }
  },

  "audit_assertions": {
    "purview_audit_row_present": true,
    "audit_row_chain_ids_threaded": ["decision_audit_row", "tier3_pii_unlock_audit_row", "actuator_audit_row"],
    "tier3_pii_unlock_audit_row_separate": true,
    "operator_principal_should_match": "maya.patel@<tenant>"
  }
}

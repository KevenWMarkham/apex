# {{ pack_id }} - Helm values
# Generated by RAPIDS apex-helm-bicep-generator

global:
  pack:
    id: {{ pack_id }}
    version: {{ pack_version }}
  cloudProfile: {{ cloud_profile }}
  environment: {{ environment }}

image:
  registry: {{ image_registry }}
  pullPolicy: IfNotPresent

resources:
  requests:
    cpu: {{ cpu_request }}
    memory: {{ memory_request }}
  limits:
    cpu: {{ cpu_limit }}
    memory: {{ memory_limit }}

vvRuntime:
  replicas: {{ vv_runtime_replicas }}

agentOrchestrator:
  replicas: {{ agent_orch_replicas }}

ledgerWriter:
  replicas: {{ ledger_writer_replicas }}

snapshotScheduler:
  enabled: true

profileEngine:
  enabled: true
  defaultProfile: {{ default_profile }}

translationLayer:
  enabled: true
  rateSource: {{ rate_source }}

observability:
  appInsights:
    connectionString: {{ app_insights_conn_string }}
  logAnalytics:
    workspaceId: {{ law_workspace_id }}

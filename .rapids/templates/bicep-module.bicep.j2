// {{ module_name }} - Bicep module
// Generated by RAPIDS apex-helm-bicep-generator
// Pack: {{ pack_id }}@{{ pack_version }}

param location string = resourceGroup().location
param environment string = 'lab'
param tags object = {
  'apex-m': 'true'
  'pack': '{{ pack_id }}'
  'env': environment
  'owner': '{{ owner }}'
  'cost-center': '{{ cost_center }}'
}

{% for resource in resources %}
resource {{ resource.symbol }} '{{ resource.type }}@{{ resource.api_version }}' = {
  name: '{{ resource.name }}'
  location: location
  tags: tags
  properties: {{ resource.properties | tojson }}
}

{% endfor %}

{% for output in outputs %}
output {{ output.name }} {{ output.type }} = {{ output.value }}
{% endfor %}

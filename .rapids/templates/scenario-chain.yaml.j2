# {{ scenario_id }} — Scenario Chain Manifest
# Pack: {{ pack_id }}@{{ pack_version }}
# Generated by RAPIDS apex-scenario-designer · {{ generated_ts }}

scenario: {{ scenario_id }}
name: {{ scenario_name }}
namespace: {{ namespace }}
industry_pack: {{ pack_id }}
services: {{ services }}
personas: {{ personas }}

uses_views:
{% for view in uses_views %}
  - {{ view }}
{% endfor %}

{% if triggered_by %}
triggered_by:
{% for trigger in triggered_by %}
  - view: {{ trigger.view }}
    band: {{ trigger.band }}
    sustain_window: {{ trigger.sustain_window }}
{% endfor %}
{% endif %}

{% if imports %}
imports:
{% for imp in imports %}
  - pack: {{ imp.pack }}
    views: {{ imp.views }}
{% endfor %}
{% endif %}

steps:
{% for step in steps %}
  - {{ step }}
{% endfor %}

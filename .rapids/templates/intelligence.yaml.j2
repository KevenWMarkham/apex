# Intelligence config — {{ pack_id }}@{{ pack_version }}
# Generated by RAPIDS

intelligence:
  memory:
    episodic:
      enabled: true
      embed_model: {{ embed_model }}
      retention: {{ episodic_retention }}
      retrieval_k: {{ retrieval_k }}
    semantic:
      enabled: true
      glossaries:
        - terminology/{{ industry }}-canonical.yaml
        - terminology/client-overrides.yaml
    procedural:
      enabled: true
      playbook_source: runbooks/playbooks/

  reasoning:
    plan:           { enabled_for: [all], depth: 2 }
    self_critique:  { enabled_for: [quantify, approve] }
    consensus:      { enabled_for: [approve], samples: 3, threshold: 0.66 }

  calibration:
    confidence_interval: { enabled: true, method: bootstrap, ci: 90 }
    ood_score:           { enabled: true, embedding_distance_threshold: 0.35 }
    action_ranking:      { enabled: true, min_p: 0.05 }

  specialists:
    quantify:
{% for spec in specialists %}
      - id: {{ spec.id }}
        when: "{{ spec.condition }}"
{% endfor %}

  outcome_learning:
    enabled: true
    outcome_window_default: {{ outcome_window }}
    aggregate_window: 30d
    rerank_threshold: 50

  constitution:
    file: constitution.yaml

  persona_model:
    enabled: true
    min_observations: 10
    adapt: [language_length, chart_preference, drill_down_depth]

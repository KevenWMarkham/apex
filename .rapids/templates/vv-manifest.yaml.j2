# {{ view_id }} — Virtual View Manifest
# Pack: {{ pack_id }}@{{ pack_version }}
# Generated by RAPIDS apex-vv-manifest-author · {{ generated_ts }}

view: {{ namespace }}.{{ view_name }}
description: {{ description }}
namespace: {{ namespace }}
industry_pack: {{ pack_id }}
{% if sub_domain %}domain: {{ sub_domain }}{% endif %}

sources:
{% for source in sources %}
  - id: {{ source.id }}
    binding: {{ source.binding }}
{% endfor %}

projection:
{% for col in projection %}
  - { col: {{ col.name }}{% if col.from %}, from: {{ col.from }}{% endif %}{% if col.expr %}, expr: "{{ col.expr }}"{% endif %} }
{% endfor %}

predicates_pushable: {{ predicates_pushable }}

thresholds:
  - metric: {{ threshold.metric }}
    bands:
      good:     {{ threshold.good }}
      warn:     {{ threshold.warn }}
      critical: {{ threshold.critical }}
    breach_emits: Exception
    severity_from: bands
    sustain_window: {{ threshold.sustain_window }}

resolution_route:
  on_warn:
    notify:  { role: {{ resolution.warn_role }}, card: {{ resolution.warn_card }}, sla: {{ resolution.warn_sla }} }
    actions: {{ resolution.warn_actions }}
  on_critical:
    notify: { role: {{ resolution.critical_role }}, card: {{ resolution.critical_card }}, sla: {{ resolution.critical_sla }} }
    escalate_after: {{ resolution.escalate_after }}
    escalate_to: { role: {{ resolution.escalate_role }}, card: {{ resolution.escalate_card }} }
    actions: {{ resolution.critical_actions }}

policies:
  row_level: {{ policies.row_level }}
  column_mask: {{ policies.column_mask }}

cache:
  mode: {{ cache.mode }}
{% if cache.ttl %}  ttl: {{ cache.ttl }}{% endif %}
{% if cache.invalidate_on %}  invalidate_on: {{ cache.invalidate_on }}{% endif %}

mcp_tool:
  name: {{ mcp_tool_name }}
  schema_from_projection: true

ledger:
  record_per_query: true
  record_per_resolution: true

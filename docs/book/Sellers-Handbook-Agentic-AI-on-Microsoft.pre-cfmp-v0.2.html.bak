              <li><label><input type="checkbox"><span>Tablet charged · network-tethered backup</span></label></li>
              <li><label><input type="checkbox"><span>Lab pre-logged-in · no auth in the room</span></label></li>
              <li><label><input type="checkbox"><span>Hide all unrelated tabs / windows</span></label></li>
              <li><label><input type="checkbox"><span>Screen-mirror to room display ready</span></label></li>
            </ul>

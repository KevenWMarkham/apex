# Client Overlay - {{ client_id }} over {{ base_pack }}@{{ base_pack_version }}
# Generated by RAPIDS apex-overlay-client

overlay: {{ client_id }}-{{ base_pack }}-overlay
extends: {{ base_pack }}@{{ base_pack_version }}

overrides:
{% for override in overrides %}
  - view: {{ override.view }}
{% for path, value in override.changes.items() %}
    {{ path }}: {{ value }}
{% endfor %}
{% endfor %}

adds:
{% for add in adds %}
  - view: {{ add }}
{% endfor %}

removes:
{% for remove in removes %}
  - view: {{ remove }}
{% endfor %}

client_specific_personas: personas.yaml
client_specific_cards: cards/

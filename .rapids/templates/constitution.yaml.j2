# Constitution — {{ pack_id }}@{{ pack_version }}
# Generated by RAPIDS apex-constitution-author · {{ generated_ts }}
# Regulatory context: {{ regulatory_context }}
# Floor version: {{ floor_version }}

constitution:
  pack: {{ pack_id }}
  version: {{ pack_version }}
  floor_inherits: apex-core/floor/constitution.yaml@{{ floor_version }}

  hard_rules:
{% for rule in hard_rules %}
    - id: {{ rule.id }}
      rule: "{{ rule.description }}"
      check: "{{ rule.check_expression }}"
      escalate_to: {{ rule.escalate_to }}
{% endfor %}

  soft_rules:
{% for rule in soft_rules %}
    - id: {{ rule.id }}
      rule: "{{ rule.description }}"
      check: "{{ rule.check_expression }}"
{% endfor %}

  independence:
{% for rule in independence_rules %}
    - id: {{ rule.id }}
      rule: "{{ rule.description }}"
      check: "{{ rule.check_expression }}"
{% endfor %}

  preserve_terms:
{% for term in preserve_terms %}
    - {{ term }}
{% endfor %}

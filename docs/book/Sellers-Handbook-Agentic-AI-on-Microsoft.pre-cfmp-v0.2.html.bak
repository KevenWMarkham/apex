<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Sellers Handbook · Agentic AI on Microsoft (Cliff Notes Edition)</title>
  <link href="https://fonts.googleapis.com/css2?family=Source+Serif+4:wght@400;600;700&family=Aptos:wght@400;600;700&family=Cascadia+Mono&display=swap" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/mermaid@10/dist/mermaid.min.js"></script>
  <style>
  :root {
    --gold: #C89D3A;
    --wrox-red: #B8232F;
    --apex-teal: #2DD4BF;
    --ms-blue: #0078D4;
    --deloitte-green: #86BC25;
    --navy: #1A2339;
    --dim: #64748B;
    --bg: #ffffff;
    --text: #1F2937;
    --code-bg: #F5F5F7;
    --border: #E5E7EB;
    --sidebar-bg: #F9FAFB;
    --note-blue: #3B82F6;
    --warning-amber: #F59E0B;
    --bp-green: #10B981;
    --keyplay-purple: #8B5CF6;
  }
  * { box-sizing: border-box; }
  html, body { margin: 0; padding: 0; overflow-x: hidden; }
  body {
    font-family: "Source Serif 4", Charter, Georgia, "Times New Roman", serif;
    background: var(--bg); color: var(--text);
    line-height: 1.6; font-size: 16px;
  }
  main, main * { min-width: 0; }
  main svg, main img { max-width: 100%; height: auto; }
  main .table-wrap { overflow-x: auto; max-width: 100%; }

  /* Layout — fixed sidebar + main content, identical pattern to trilogy */
  .layout { display: block; min-height: 100vh; padding-left: 280px; }
  .topbar {
    position: sticky; top: 0; z-index: 100;
    background: var(--navy); color: #fff;
    padding: 12px 24px; display: flex; align-items: center; gap: 16px;
    border-bottom: 2px solid var(--gold);
  }
  .topbar .book-brand {
    font-family: Aptos, "Segoe UI", sans-serif;
    font-weight: 700; font-size: 16px; color: #fff; text-decoration: none;
  }
  .topbar .book-brand .accent { color: var(--gold); }
  .topbar .current-chapter {
    flex: 1; color: #94A3B8; font-size: 14px;
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }
  .trilogy-nav { display: flex; align-items: center; gap: 4px; font-family: Aptos, sans-serif; font-size: 12px; }
  .trilogy-nav .label { color: #94A3B8; letter-spacing: 0.15em; font-size: 10px; font-weight: 700; text-transform: uppercase; margin-right: 6px; }
  .trilogy-nav a {
    display: inline-block; padding: 4px 10px;
    border: 1px solid rgba(255,255,255,0.25); border-radius: 4px;
    color: #fff; text-decoration: none; font-weight: 700;
  }
  .trilogy-nav a.active { background: var(--gold); color: var(--navy); border-color: var(--gold); }
  .trilogy-nav a:hover:not(.active) { background: rgba(255,255,255,0.10); }

  .sidebar {
    background: var(--sidebar-bg); border-right: 1px solid var(--border);
    padding: 20px 16px; overflow-y: auto;
    position: fixed; top: 56px; left: 0; bottom: 0; width: 280px; z-index: 50;
    font-family: Aptos, "Segoe UI", sans-serif; font-size: 13px;
  }
  .sidebar h3 { font-size: 11px; text-transform: uppercase; letter-spacing: 0.1em; color: var(--dim); margin: 16px 0 6px; }
  .sidebar .part-title { font-weight: 700; color: var(--gold); font-size: 12px; margin: 14px 0 4px; text-transform: uppercase; letter-spacing: 0.08em; }
  .sidebar ul { list-style: none; padding: 0; margin: 0; }
  .sidebar li { margin: 2px 0; }
  .sidebar a { color: var(--text); text-decoration: none; display: block; padding: 4px 8px; border-radius: 4px; }
  .sidebar a:hover { background: var(--border); }

  main { padding: 36px 56px; max-width: 920px; }

  /* COVER */
  .cover {
    padding: 80px 60px; text-align: center;
    margin: -36px -56px 40px;
    background: linear-gradient(135deg, var(--navy) 0%, #0B111E 100%);
    color: #fff; border-bottom: 3px solid var(--gold);
  }
  .cover .brand { font-family: Aptos, sans-serif; font-size: 18px; letter-spacing: 0.4em; color: var(--gold); text-transform: uppercase; font-weight: 700; }
  .cover .title { font-family: Aptos, sans-serif; font-size: 52px; line-height: 1.1; margin: 18px 0 6px; font-weight: 700; }
  .cover .title .accent { color: var(--gold); }
  .cover .subtitle { font-family: Aptos, sans-serif; font-size: 24px; color: var(--apex-teal); margin: 8px 0 16px; }
  .cover .edition { font-family: Aptos, sans-serif; font-size: 16px; color: var(--gold); font-style: italic; margin: 4px 0 24px; }
  .cover .tagline { font-size: 16px; color: #E5E7EB; max-width: 640px; margin: 0 auto 28px; }
  .cover .volume-badge {
    display: inline-block; border: 1px solid var(--gold); color: var(--gold);
    padding: 4px 14px; margin: 8px 0 4px;
    font-family: Aptos, sans-serif; font-weight: 700;
    letter-spacing: 0.25em; font-size: 12px; text-transform: uppercase;
  }
  .cover .wrox-label {
    display: inline-block; background: var(--gold); color: var(--navy); padding: 8px 20px;
    font-family: Aptos, sans-serif; font-weight: 700; letter-spacing: 0.1em; font-size: 14px; margin-top: 24px;
  }
  .cover .byline { font-size: 14px; color: #94A3B8; margin-top: 36px; }

  /* PARTS */
  .part-opener { padding: 60px 0 40px; border-top: 4px solid var(--gold); border-bottom: 1px solid var(--border); margin: 60px 0 40px; }
  .part-opener .part-label { font-family: Aptos, sans-serif; font-size: 13px; letter-spacing: 0.3em; color: var(--gold); text-transform: uppercase; font-weight: 700; }
  .part-opener .part-title { font-family: Aptos, sans-serif; font-size: 44px; margin: 10px 0 18px; color: var(--navy); }
  .part-opener .part-intro { font-size: 17px; line-height: 1.6; max-width: 720px; font-style: italic; color: var(--dim); }

  /* CHAPTERS */
  .chapter { margin-bottom: 56px; }
  .chapter-header { border-bottom: 3px solid var(--gold); padding-bottom: 14px; margin-bottom: 22px; }
  .chapter-number { font-family: Aptos, sans-serif; font-size: 13px; letter-spacing: 0.2em; color: var(--gold); text-transform: uppercase; font-weight: 700; }
  .chapter-title { font-family: Aptos, sans-serif; font-size: 32px; margin: 6px 0 0; color: var(--navy); line-height: 1.15; }

  /* Cliff-Notes "At-a-Glance" box — every chapter opens with one */
  .glance {
    background: var(--code-bg); border-left: 4px solid var(--gold);
    padding: 16px 20px; margin: 0 0 24px; font-family: Aptos, sans-serif; font-size: 14px;
  }
  .glance .glance-label {
    font-size: 11px; letter-spacing: 0.18em; text-transform: uppercase;
    color: var(--gold); font-weight: 700; margin-bottom: 8px;
  }
  .glance table { width: 100%; border-collapse: collapse; }
  .glance td { padding: 4px 8px 4px 0; vertical-align: top; font-size: 14px; }
  .glance td:first-child { width: 130px; font-weight: 700; color: var(--navy); text-transform: uppercase; font-size: 11px; letter-spacing: 0.08em; padding-top: 6px; }

  h1, h2, h3, h4 { font-family: Aptos, sans-serif; color: var(--navy); }
  h1 { font-size: 28px; border-bottom: 2px solid var(--border); padding-bottom: 8px; margin-top: 36px; }
  h2 { font-size: 22px; margin-top: 28px; }
  h3 { font-size: 17px; margin-top: 22px; color: var(--navy); }
  h4 { font-size: 14px; margin-top: 16px; text-transform: uppercase; letter-spacing: 0.06em; color: var(--dim); }
  p { margin: 0 0 12px; }
  ul, ol { margin: 0 0 14px; padding-left: 24px; }
  li { margin: 4px 0; }

  /* Step ladder — the workhorse of Cliff Notes baby steps */
  .steps { counter-reset: step; list-style: none; padding-left: 0; margin: 14px 0 18px; }
  .steps > li {
    counter-increment: step;
    position: relative; padding: 8px 8px 8px 44px; margin: 6px 0;
    border-left: 3px solid var(--apex-teal); background: rgba(45, 212, 191, 0.06);
    font-size: 15px;
  }
  .steps > li::before {
    content: counter(step);
    position: absolute; left: 8px; top: 8px;
    width: 26px; height: 26px; border-radius: 50%;
    background: var(--navy); color: #fff;
    font-family: Aptos, sans-serif; font-weight: 700; font-size: 13px;
    display: flex; align-items: center; justify-content: center;
  }

  /* Collapsible step + sub-task checklist (native <details>/<summary>) */
  .steps > li > details { margin: 0; }
  .steps > li > details > summary {
    list-style: none; cursor: pointer; display: block;
    position: relative; padding-right: 26px; outline: none;
  }
  .steps > li > details > summary::-webkit-details-marker { display: none; }
  .steps > li > details > summary::after {
    content: "▾";
    position: absolute; right: 2px; top: 0;
    color: var(--dim); font-size: 12px;
    transition: transform 0.18s ease;
    font-family: Aptos, "Segoe UI", sans-serif;
  }
  .steps > li > details[open] > summary::after { transform: rotate(180deg); color: var(--apex-teal); }
  .steps > li > details > summary:hover::after { color: var(--ms-blue); }

  .subtasks {
    margin: 12px 0 4px; padding: 12px 14px;
    background: #fff; border: 1px solid var(--border);
    border-left: 3px solid var(--apex-teal); border-radius: 4px;
    font-size: 13.5px; line-height: 1.55;
  }
  .subtasks-label {
    font-family: Aptos, sans-serif;
    font-size: 10.5px; letter-spacing: 0.14em; text-transform: uppercase;
    color: var(--apex-teal); font-weight: 700; margin-bottom: 8px;
  }
  .subtasks ul { list-style: none; padding: 0; margin: 0; }
  .subtasks li { padding: 3px 0; margin: 0; }
  .subtasks label {
    display: flex; gap: 9px; align-items: flex-start; cursor: pointer;
  }
  .subtasks input[type="checkbox"] {
    margin: 4px 0 0; flex-shrink: 0;
    accent-color: var(--apex-teal);
    width: 14px; height: 14px; cursor: pointer;
  }
  .subtasks li:has(input:checked) span {
    text-decoration: line-through; color: var(--dim);
  }

  /* ===== Selling Process integration · phase chips · carry-forward · journey strip ===== */
  .phase-chip {
    display: inline-block; font-family: Aptos, sans-serif;
    font-size: 10.5px; letter-spacing: 0.14em; text-transform: uppercase;
    font-weight: 700; padding: 3px 11px; border-radius: 12px; color: #fff;
  }
  .phase-chip.ready { background: #64748B; }
  .phase-chip.meet { background: #0F766E; }
  .phase-chip.wedge { background: #1D4ED8; }
  .phase-chip.sell { background: #0078D4; }
  .phase-chip.scale { background: #B45309; }
  .phase-chip.annuity { background: #5C9300; }
  .phase-chip.advisory { background: #C89D3A; color: #1A2339; }

  /* Carry-forward — flows the seller motion chapter-to-chapter */
  .carry-forward {
    margin: 22px 0 8px; padding: 14px 18px;
    background: linear-gradient(135deg, rgba(45, 212, 191, 0.05), rgba(0, 120, 212, 0.04));
    border: 1px solid var(--border);
    border-left: 4px solid var(--apex-teal);
    border-radius: 4px;
    font-family: Aptos, sans-serif; font-size: 13.5px;
  }
  .cf-header {
    display: flex; justify-content: space-between; align-items: center;
    margin-bottom: 12px; padding-bottom: 10px;
    border-bottom: 1px dashed var(--border);
  }
  .cf-progress {
    font-size: 10.5px; letter-spacing: 0.12em; text-transform: uppercase;
    color: var(--dim); font-weight: 700;
  }
  .cf-grid {
    display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 14px;
  }
  .cf-cell { padding: 4px 0; }
  .cf-label {
    font-size: 10px; letter-spacing: 0.14em; text-transform: uppercase;
    color: var(--apex-teal); font-weight: 700; margin-bottom: 4px;
  }
  .cf-content {
    font-size: 13px; color: var(--text); line-height: 1.5;
  }
  .cf-content a {
    color: var(--ms-blue); font-weight: 700; text-decoration: none;
  }
  .cf-content a:hover { text-decoration: underline; }

  /* Journey strip — 6-phase overview shown in front matter */
  .journey-strip {
    display: grid; grid-template-columns: repeat(6, 1fr); gap: 0;
    margin: 22px 0; font-family: Aptos, sans-serif;
    border: 1px solid var(--border); border-radius: 6px;
    overflow: hidden; font-size: 11px;
  }
  .js-phase {
    padding: 14px 8px; text-align: center;
    border-right: 1px solid var(--border);
    background: #fff; color: var(--dim);
    position: relative;
  }
  .js-phase:last-child { border-right: none; }
  .js-phase .js-num {
    display: block; font-weight: 700; font-size: 18px;
    color: var(--gold); margin-bottom: 4px;
  }
  .js-phase .js-name {
    text-transform: uppercase; letter-spacing: 0.1em;
    font-weight: 700; color: var(--navy); font-size: 11.5px;
    margin-bottom: 4px; display: block;
  }
  .js-phase .js-chapters {
    font-size: 10px; color: var(--dim); line-height: 1.5;
  }
  .js-phase.ready { background: rgba(100, 116, 139, 0.06); }
  .js-phase.meet { background: rgba(15, 118, 110, 0.07); }
  .js-phase.wedge { background: rgba(29, 78, 216, 0.06); }
  .js-phase.sell { background: rgba(0, 120, 212, 0.08); }
  .js-phase.scale { background: rgba(180, 83, 9, 0.07); }
  .js-phase.annuity { background: rgba(92, 147, 0, 0.08); }
  @media (max-width: 700px) {
    .journey-strip { grid-template-columns: repeat(2, 1fr); }
    .cf-grid { grid-template-columns: 1fr; }
  }

  /* Two-column "Say / Don't Say" */
  .saynot { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin: 18px 0; }
  .saynot .col { padding: 12px 14px; border-radius: 4px; font-size: 14px; }
  .saynot .say { background: rgba(134, 188, 37, 0.08); border-left: 4px solid var(--deloitte-green); }
  .saynot .nope { background: rgba(184, 35, 47, 0.05); border-left: 4px solid var(--wrox-red); }
  .saynot .col h4 { margin: 0 0 6px; font-size: 12px; letter-spacing: 0.12em; }
  .saynot .say h4 { color: var(--deloitte-green); }
  .saynot .nope h4 { color: var(--wrox-red); }
  .saynot ul { margin: 0; padding-left: 18px; }
  .saynot li { margin: 3px 0; font-size: 13.5px; }

  /* Callouts */
  .callout { margin: 16px 0; padding: 12px 16px; border-left: 4px solid; background: var(--code-bg); border-radius: 4px; font-size: 14.5px; }
  .callout-label { font-family: Aptos, sans-serif; font-weight: 700; font-size: 11px; letter-spacing: 0.15em; text-transform: uppercase; margin-bottom: 6px; }
  .callout.note { border-color: var(--note-blue); }
  .callout.note .callout-label { color: var(--note-blue); }
  .callout.warning { border-color: var(--warning-amber); background: rgba(245, 158, 11, 0.06); }
  .callout.warning .callout-label { color: var(--warning-amber); }
  .callout.independence { border-color: var(--gold); background: rgba(200, 157, 58, 0.09); }
  .callout.independence .callout-label { color: var(--gold); }
  .callout.attach { border-color: var(--ms-blue); background: rgba(0, 120, 212, 0.06); }
  .callout.attach .callout-label { color: var(--ms-blue); }
  .callout.keyplay { border-color: var(--keyplay-purple); background: rgba(139, 92, 246, 0.05); }
  .callout.keyplay .callout-label { color: var(--keyplay-purple); }
  .callout p:last-child { margin-bottom: 0; }

  /* Tables */
  .md-table { width: 100%; border-collapse: collapse; font-size: 14px; margin: 14px 0; }
  .md-table th { background: var(--navy); color: #fff; padding: 8px 12px; text-align: left; font-family: Aptos, sans-serif; font-weight: 600; font-size: 13px; }
  .md-table td { padding: 8px 12px; border: 1px solid var(--border); }
  .md-table tr:nth-child(even) td { background: var(--code-bg); }

  /* Figure (inline SVG flow diagrams — Toyota reference pattern) */
  figure {
    border: 1px solid var(--border); border-left: 4px solid var(--ms-blue);
    padding: 18px 22px; background: #fff;
    border-radius: 0 6px 6px 0;
    margin: 22px 0; overflow: hidden;
  }
  figure .fig-label {
    font-family: Aptos, sans-serif; font-size: 11px; letter-spacing: 0.16em;
    text-transform: uppercase; color: #005A9E; font-weight: 700;
    margin-bottom: 10px;
  }
  figure svg { display: block; width: 100%; height: auto; }
  figcaption {
    margin-top: 12px; padding-top: 10px;
    border-top: 1px dashed var(--border);
    font-size: 13px; color: var(--dim); line-height: 1.55;
  }

  /* Step grid — Toyota two-column pattern for compact step lists */
  .step-grid {
    display: grid; grid-template-columns: 1fr 1fr; gap: 8px;
    margin: 14px 0; font-size: 13.5px;
  }
  .step-grid .step {
    background: var(--code-bg); border: 1px solid var(--border);
    padding: 8px 12px; border-radius: 4px;
    display: flex; gap: 10px; align-items: flex-start;
  }
  .step-grid .step .step-num {
    font-family: "Cascadia Mono", Consolas, monospace; font-size: 12px;
    color: var(--ms-blue); font-weight: 700; min-width: 28px;
  }
  .step-grid .step .step-body strong { color: var(--navy); }

  /* Source badges */
  .src {
    display: inline-block; font-family: Aptos, sans-serif;
    font-size: 10px; letter-spacing: 0.1em; font-weight: 700;
    padding: 2px 8px; border-radius: 3px; margin-right: 6px;
    background: var(--dim); color: #fff; text-transform: uppercase;
  }
  .src.ms { background: var(--ms-blue); }
  .src.deloitte { background: var(--deloitte-green); }
  .src.apex { background: var(--gold); }
  .src.practice { background: var(--navy); }

  /* Legacy Mermaid frame kept in case any later diagrams use it */
  .mermaid-wrap { background: #fff; border: 1px solid var(--border); border-radius: 6px; padding: 18px; margin: 22px 0; text-align: center; overflow-x: auto; }

  /* Revenue chip */
  .rev-chip { display: inline-block; background: var(--deloitte-green); color: #fff; padding: 2px 10px; border-radius: 12px; font-family: Aptos, sans-serif; font-size: 12px; font-weight: 700; letter-spacing: 0.04em; }
  .ms-chip { display: inline-block; background: var(--ms-blue); color: #fff; padding: 2px 10px; border-radius: 12px; font-family: Aptos, sans-serif; font-size: 12px; font-weight: 700; }

  /* Print */
  @media print { .sidebar, .topbar { display: none; } .layout { padding-left: 0; } main { max-width: none; padding: 20px; } }
  </style>
</head>
<body>

<div class="topbar">
  <a href="#cover" class="book-brand">SELLERS <span class="accent">HANDBOOK</span></a>
  <div class="current-chapter">Agentic AI on Microsoft · Cliff Notes Edition · v1.0</div>
  <div class="trilogy-nav">
    <span class="label">Companion</span>
    <a href="Professional-APEX-M-Sellers-Guide.html">Sellers Guide</a>
    <a href="Professional-APEX-M-Services-Guide.html">Services</a>
    <a href="Professional-APEX-M-Implementation-Guide-(Vuori-Example).html">Implementation</a>
    <a href="#cover" class="active">Handbook</a>
  </div>
</div>

<div class="layout">


              <li><label><input type="checkbox"><span>Identify channel-level HITL gates</span></label></li>
              <li><label><input type="checkbox"><span>Wire consent flow via Purview labels</span></label></li>
            </ul>
          </div>
        </details></li>
        <li><details>

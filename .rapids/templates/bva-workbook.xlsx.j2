# Note: this is a Jinja-evaluated descriptor.
# The actual .xlsx is generated by openpyxl using this descriptor as input.

workbook:
  name: {{ pack_id }}-roi.xlsx
  sheets:
    - name: Inputs
      headers: {{ input_headers }}
      rows: []  # client fills in
    - name: Assumptions
      content: |
        Pack: {{ pack_id }}@{{ pack_version }}
        Industry baselines from APEX catalog
    - name: ROI Calculation
      formula_driven: true
    - name: Sensitivity Analysis
      content: scenarios + tornado chart
    - name: Summary
      content: P10 · P50 · P90 ROI · payback period

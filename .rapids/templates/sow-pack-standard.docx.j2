# T2 Pack Standard (Pilot) SOW
sow:
  type: T2 Pack Standard (Pilot)
  pack: {{ pack_id }}@{{ pack_version }}
  duration: 12-16 weeks
  fee_band: $500K - $1.5M
  deliverables:
    - 1 sub-domain live with all VVs
    - 3-5 scenario chains in production
    - Client overlay configured
    - Pack acceptance pack green (all 60+ tests)
    - Operate handoff package

# Note: this is a Jinja-evaluated descriptor.
# The actual .docx is generated by python-docx using this descriptor as input.

sow:
  type: T2 Pack Lite (Discover)
  pack: {{ pack_id }}@{{ pack_version }}
  duration: 4-6 weeks
  fee_band: $100K - $250K
  deliverables:
    - BVA workshop (4-hour)
    - Stakeholder map + persona discovery
    - 1 demo VV on client data
    - Pack Lite report + ROI worksheet
  acceptance_criteria:
    - Pack acceptance pack subset passes
    - BVA workbook signed off by client sponsor
  funding_paths: {{ funding_paths }}

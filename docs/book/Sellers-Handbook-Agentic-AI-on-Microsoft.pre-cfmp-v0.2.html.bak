              <li><label><input type="checkbox"><span>Confirm LCSP availability per account</span></label></li>
              <li><label><input type="checkbox"><span>Lock the three accounts by name</span></label></li>
            </ul>
          </div>
        </details></li>
        <li><details>
          <summary><strong>Schedule per-account brainstorm</strong> with the Engagement Partner.</summary>
          <div class="subtasks">
            <div class="subtasks-label">Sub-tasks</div>

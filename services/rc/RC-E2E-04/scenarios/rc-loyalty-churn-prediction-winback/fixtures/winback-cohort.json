{
  "$schema": "https://apex.deloitte.com/schemas/smoke-test-fixture-v1.json",
  "fixture_id": "rc-loyalty-churn-prediction-winback--canonical-1",
  "description": "Canonical synthetic loyalty-churn cohort per Services Guide §18.2 envelope. 5-member top-tier cohort with one elevated-risk platinum, two moderate-risk, one consent-blocked, one anti-fatigue-blocked. Drives the full 24-step chain end-to-end via mocks.",

  "trigger": {
    "kind": "weekly-loyalty-churn-batch",
    "tenant_id": "labtenant",
    "window_start": "2026-05-04T00:00:00Z",
    "window_end":   "2026-05-11T00:00:00Z",
    "tier_filter":  "top_tier",
    "trigger_at":   "2026-05-11T09:00:00Z"
  },

  "cohort": [
    {
      "customer_token": "tok-cust-A",
      "loyalty_tier": "platinum",
      "lifetime_value_bucket": "high",
      "trailing_90d_visit_count": 4,
      "trailing_90d_visit_count_prior_period": 12,
      "visit_velocity_change_pct": -67.0,
      "service_interactions_negative_count": 3,
      "consent_marketing": true,
      "consent_personalization": true,
      "prior_winback_count_12m": 0,
      "prior_winback_response_rate_lifetime": null,
      "expected_winback_propensity_signal": "elevated",
      "expected_churn_risk_class": "high"
    },
    {
      "customer_token": "tok-cust-B",
      "loyalty_tier": "gold",
      "lifetime_value_bucket": "mid",
      "trailing_90d_visit_count": 8,
      "trailing_90d_visit_count_prior_period": 10,
      "visit_velocity_change_pct": -20.0,
      "service_interactions_negative_count": 1,
      "consent_marketing": true,
      "consent_personalization": true,
      "prior_winback_count_12m": 1,
      "prior_winback_response_rate_lifetime": 12.0,
      "expected_winback_propensity_signal": "low",
      "expected_churn_risk_class": "low"
    },
    {
      "customer_token": "tok-cust-C",
      "loyalty_tier": "platinum",
      "lifetime_value_bucket": "high",
      "trailing_90d_visit_count": 6,
      "trailing_90d_visit_count_prior_period": 9,
      "visit_velocity_change_pct": -33.3,
      "service_interactions_negative_count": 2,
      "consent_marketing": true,
      "consent_personalization": true,
      "prior_winback_count_12m": 0,
      "prior_winback_response_rate_lifetime": null,
      "expected_winback_propensity_signal": "elevated",
      "expected_churn_risk_class": "medium"
    },
    {
      "customer_token": "tok-cust-D",
      "loyalty_tier": "gold",
      "lifetime_value_bucket": "high",
      "trailing_90d_visit_count": 5,
      "trailing_90d_visit_count_prior_period": 9,
      "visit_velocity_change_pct": -44.4,
      "service_interactions_negative_count": 2,
      "consent_marketing": false,

# apex-m/infra/docker-compose/.env.example
#
# Reference for every env var an APEX-M agent container reads on the
# laptop substrate. The wizard's render endpoint generates a populated
# .env per engagement; this file documents the schema for operators
# who edit by hand.

# ===== Substrate identity =====
APEX_SUBSTRATE=laptop                    # laptop | dev | stage | prod
APEX_VARIANT=APEX-M                      # APEX-M | APEX-G | APEX-A
APEX_FORCE_MOCK=true                     # routes Microsoft SDK calls to Mock* impls

# ===== APEX position =====
APEX_TENANT=contoso-laptop               # tenant slug (laptop = engineer's box)
APEX_USE_CASE_ID=rc-e2e-03--default      # use-case yaml id

# ===== Personas active per the use case =====
APEX_PERSONAS=marisol-reyes-store-ops,daniel-chen-merch-director

# ===== HITL thresholds (per the use case) =====
APEX_HITL_MARKDOWN_PCT=30
APEX_HITL_DESTROY_DECISION=any
APEX_HITL_REFUND_USD=500

# ===== Mock endpoint URLs (set automatically by docker-compose) =====
APEX_ENTRA_ENDPOINT=http://apex-mock-entra:8080
APEX_FOUNDRY_ENDPOINT=http://apex-mock-foundry:8080
APEX_FABRIC_ENDPOINT=http://apex-mock-fabric:8080
APEX_PURVIEW_ENDPOINT=http://apex-mock-purview:8080
APEX_DEFENDER_ENDPOINT=http://apex-mock-defender:8080
APEX_REDIS_HOST=apex-mock-redis
APEX_REDIS_PORT=6379

# ===== Agent overrides (per role, populated from use case agent_overrides) =====
APEX_AGENT_MODEL_PRICING=gpt-4o-2024-11-20
APEX_REDIS_EPISODIC_PRICING=true
APEX_LEARNING_LOOP_DAYS_PRICING=90

# ===== Adapter endpoints (per client_approved_architecture) =====
# These are populated when adapters are referenced in the use case;
# laptop substrate uses mock adapter containers.
APEX_BRONZE_POS_ADAPTER=cloud.aws.rds      # but routed to mock-aws-rds container
APEX_BRONZE_POS_DATASET=contoso-pos-prod
APEX_SIEM_SECONDARY_ADAPTER=siem.splunk    # but routed to mock-splunk container
APEX_FEDERATION_ADAPTER=identity.okta      # but routed to mock-okta container

# ===== Substrate-only knobs =====
APEX_LOG_LEVEL=DEBUG                     # production substrates default to INFO
APEX_TRACE_TO_STDOUT=true                # observability mock writes here

          <tr><td>TMT</td><td>Technology, Media & Telecom</td><td>Planned</td><td>TMT</td><td>30</td></tr>
          <tr><td>ER</td><td>Energy & Resources</td><td>Planned</td><td>Oil & Gas · Power · Mining</td><td>32</td></tr>
